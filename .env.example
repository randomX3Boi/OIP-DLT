# Copy this file to .env and replace every placeholder below.
# Never put real private keys in .env.example or commit your .env file.

# Account 1: contract deployer, owner, and first voter
HEDERA_OPERATOR_ID=0.0.YOUR_ACCOUNT_1_ID
HEDERA_OPERATOR_KEY=YOUR_ACCOUNT_1_PRIVATE_KEY
HEDERA_OPERATOR_KEY_TYPE=ECDSA

# Account 2: second voter
HEDERA_OPERATOR_ID_2=0.0.YOUR_ACCOUNT_2_ID
HEDERA_OPERATOR_KEY_2=YOUR_ACCOUNT_2_PRIVATE_KEY
HEDERA_OPERATOR_KEY_TYPE_2=ECDSA

# Replace ECDSA with ED25519 only when that account uses an ED25519 key.
# DER-encoded private keys are detected automatically by the scripts.

# Paste the contract ID printed by deploy.js after deployment.
VOTING_CONTRACT_ID=0.0.YOUR_CONTRACT_ID

# Optional additional voter accounts use matching numbered suffixes:
# HEDERA_OPERATOR_ID_3=0.0.YOUR_ACCOUNT_3_ID
# HEDERA_OPERATOR_KEY_3=YOUR_ACCOUNT_3_PRIVATE_KEY
# HEDERA_OPERATOR_KEY_TYPE_3=ECDSA
